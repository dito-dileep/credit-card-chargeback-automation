<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_Ledger"
                  targetNamespace="http://chargeback.demo">
  <bpmn:process id="core-banking-ledger-reversal" name="Core Banking Ledger Reversal" isExecutable="true">
    <bpmn:startEvent id="start" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="reversal" />
    <bpmn:serviceTask id="reversal" name="Post simulated ledger reversal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ledger-reversal" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="f2" sourceRef="reversal" targetRef="success" />
    <bpmn:endEvent id="success" name="Ledger reversal completed" />
  </bpmn:process>
</bpmn:definitions>
