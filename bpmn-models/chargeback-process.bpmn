<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Chargeback" targetNamespace="http://chargeback.demo">
  <bpmn:process id="chargeback-dispute" name="Multi-Transaction Chargeback Dispute" isExecutable="true">
    <bpmn:startEvent id="start"/><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate"/>
    <bpmn:serviceTask id="validate" name="Validate chargeback request"><bpmn:extensionElements><zeebe:taskDefinition type="validate-chargeback"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="items"/>
    <bpmn:subProcess id="items" name="Evaluate disputed transactions"><bpmn:multiInstanceLoopCharacteristics isSequential="false"><bpmn:loopCardinality>${transactions.size()}</bpmn:loopCardinality><bpmn:extensionElements><zeebe:loopCharacteristics inputCollection="=transactions" inputElement="transaction" outputCollection="results" outputElement="result"/></bpmn:extensionElements></bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="itemStart"/><bpmn:sequenceFlow id="i1" sourceRef="itemStart" targetRef="metadata"/>
      <bpmn:serviceTask id="metadata" name="Fetch transaction metadata (REST worker)"><bpmn:extensionElements><zeebe:taskDefinition type="fetch-transaction-metadata"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="i2" sourceRef="metadata" targetRef="evaluate"/>
      <bpmn:serviceTask id="evaluate" name="Evaluate transaction"><bpmn:extensionElements><zeebe:taskDefinition type="evaluate-transaction"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="i3" sourceRef="evaluate" targetRef="eligible"/>
      <bpmn:exclusiveGateway id="eligible" name="Eligible?"/><bpmn:sequenceFlow id="i4" sourceRef="eligible" targetRef="merchant" ><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=eligible</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="i5" sourceRef="eligible" targetRef="itemEnd"/>
      <bpmn:subProcess id="merchant" name="Merchant Representment Window"><bpmn:startEvent id="mStart"/><bpmn:sequenceFlow id="m1" sourceRef="mStart" targetRef="request"/><bpmn:serviceTask id="request" name="Send merchant response request"><bpmn:extensionElements><zeebe:taskDefinition type="send-merchant-request"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="m2" sourceRef="request" targetRef="wait"/><bpmn:intermediateCatchEvent id="wait" name="Wait for merchant response"><bpmn:messageEventDefinition messageRef="merchantResponse"/></bpmn:intermediateCatchEvent><bpmn:boundaryEvent id="deadline" attachedToRef="wait" cancelActivity="true" name="3-day deadline"><bpmn:timerEventDefinition><bpmn:timeDuration>P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:sequenceFlow id="m3" sourceRef="wait" targetRef="response"/><bpmn:serviceTask id="response" name="Evaluate merchant response"><bpmn:extensionElements><zeebe:taskDefinition type="evaluate-merchant-response"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:endEvent id="mEnd"/><bpmn:sequenceFlow id="m4" sourceRef="response" targetRef="mEnd"/><bpmn:endEvent id="timeoutEnd" name="Merchant timeout"/><bpmn:sequenceFlow id="m5" sourceRef="deadline" targetRef="timeoutEnd"/></bpmn:subProcess>
      <bpmn:sequenceFlow id="i6" sourceRef="merchant" targetRef="approved"/><bpmn:exclusiveGateway id="approved" name="Dispute approved?"/><bpmn:sequenceFlow id="i7" sourceRef="approved" targetRef="ledger"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=approved</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="i8" sourceRef="approved" targetRef="itemEnd"/><bpmn:callActivity id="ledger" name="Core Banking Ledger Reversal" calledElement="core-banking-ledger-reversal"/><bpmn:sequenceFlow id="i9" sourceRef="ledger" targetRef="itemEnd"/><bpmn:endEvent id="itemEnd"/>
    </bpmn:subProcess><bpmn:sequenceFlow id="f3" sourceRef="items" targetRef="notify"/><bpmn:serviceTask id="notify" name="Notify customer"><bpmn:extensionElements><zeebe:taskDefinition type="notify-customer"/></bpmn:extensionElements></bpmn:serviceTask><bpmn:sequenceFlow id="f4" sourceRef="notify" targetRef="end"/><bpmn:endEvent id="end"/>
  </bpmn:process><bpmn:message id="merchantResponse" name="merchantResponse"/>
</bpmn:definitions>
